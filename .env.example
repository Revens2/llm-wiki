# Configuration du pipeline llm-wiki — DOCUMENTATION UNIQUEMENT (aucune valeur).
# En production ces variables vivent dans /etc/default/llm-wiki (racine, 0640).
#
# Bascule ChatGPT-seul (2026-09-09, contrat wiki-extract-v4) : AUCUN appel LLM
# local. L'ancien bloc de soumission (cle distante, mode de soumission, binaire
# externe, cascade de modeles, pacing AIMD, quota) est RETIRE. Le raisonnement
# est fait par ChatGPT via la file MCP (vault-mcp wiki_jobs.py, autorite
# serveur) ; ici ne restent que des reglages deterministes.

# --- Extraction (llm_wiki_extract.py : contrat + chunking local + spool) ---
EXTRACT_SPOOL=
EXTRACT_MAX_OUTPUT_TOKENS=65536

# --- File ChatGPT (consommee par vault-mcp wiki_jobs.py, rappelee ici) -----
# WIKI_JOBS_DB=/var/lib/vault-mcp/wiki_jobs.db
# WIKI_JOBS_SPOOL=/var/lib/llm-wiki/spool/extract
# WIKI_JOBS_MANIFEST=/var/lib/llm-wiki/wiki_jobs_manifest.jsonl
# WIKI_RAW_DIR=/srv/vault-mirror/raw
# WIKI_EXCLUDE_DIRS=/srv/vault-mirror/raw/assets/ConvIA
# WIKI_CHUNK_MIN_TOKENS=50000
# WIKI_CHUNK_MIN_FLOOR=8000

# --- Strategie de decoupage (chunking deterministe, tokenizer local) -------
CHUNK_MIN_TOKENS=50000
CHUNK_MIN_TOKENS_FLOOR=8000
CHUNK_TARGET_RATIO=
CHUNK_OVERLAP_RATIO=
BYTES_PER_TOKEN=

# --- Chemins (defauts raisonnables ; a adapter au deploiement) -----------
LLM_WIKI_STATE_DIR=/var/lib/llm-wiki
RAW_DIR=
WIKI_DIR=
MANIFEST=

# --- Divers ---------------------------------------------------------------
# (Reprises quota historiques : plus ecrites depuis la bascule. La cadence est
# portee par l'unique tache horaire ChatGPT.)
