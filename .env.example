# Configuration du pipeline llm-wiki — DOCUMENTATION UNIQUEMENT (aucune valeur).
# En production ces variables vivent dans /etc/default/llm-wiki (racine, 0640).

# --- Soumission LLM (llm_submit.py) -------------------------------------
GEMINI_API_KEY=                 # clé API Google AI Studio
SUBMIT_MODE=interactive         # interactive | batch | agy
LLM_MODEL=                      # modèle par défaut (mode agy)
AGY_BIN=                        # binaire agy optionnel (mode agy)

# --- Extraction (llm_wiki_extract.py) -----------------------------------
EXTRACT_MODEL=gemini-2.5-flash-lite
EXTRACT_MODEL_CASCADE=
EXTRACT_SPOOL=
EXTRACT_MAX_OUTPUT_TOKENS=65536

# --- Pacing / quota (AIMD) ----------------------------------------------
MIN_INTERVAL_MS=1500
MAX_INTERVAL_MS=300000
START_INTERVAL_MS=4000
AIMD_STEP_MS=250
AIMD_OK_STREAK=10
AIMD_MD_FACTOR=2.0
PACE_JITTER_RATIO=0.3
MAX_LOCAL_RETRIES=3
MAX_TRANSIENT_RETRIES=3
TRANSIENT_BASE_S=2
RESUME_DELAY_SECONDS=18180
QUOTA_SAFETY_MARGIN=3
QUOTA_RESET_TZ=America/Los_Angeles

# --- Stratégie de découpage (chunking piloté TPM) ------------------------
CHUNK_MIN_TOKENS=50000
CHUNK_MIN_TOKENS_FLOOR=8000
CHUNK_TARGET_RATIO=
CHUNK_OVERLAP_RATIO=
BYTES_PER_TOKEN=

# --- Chemins (défauts raisonnables ; à adapter au déploiement) -----------
LLM_WIKI_STATE_DIR=/var/lib/llm-wiki
RAW_DIR=
WIKI_DIR=
MANIFEST=

# --- Divers ---------------------------------------------------------------
DAILY_CONFIRM_STRIKES=3
DAILY_CONFIRM_MAX_WAIT_S=300
